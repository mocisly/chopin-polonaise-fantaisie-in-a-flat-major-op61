restAt =
#(define-music-function (position music) (number? ly:music?)
   #{ \tweak staff-position #position #music #})

% Ordinary rests without a simultaneous second voice.
centerRest = \tweak staff-position #0 \etc

% Fixed-edition print marks, positioned relative to the current system and staff.
#(define (op61-pedal-offset x y)
   (lambda (grob)
     (let* ((system (ly:grob-system grob))
            (staff (op61-staff-of grob)))
       (if (and (ly:grob? system) (ly:grob? staff))
           (begin
             (op61-place-columns system)
             (let* ((space (ly:staff-symbol-staff-space grob))
                    (left (ly:spanner-bound staff LEFT))
                    (origin (ly:grob-relative-coordinate left system X))
                    (now-x (ly:grob-relative-coordinate grob system X))
                    (now-y (op61-relative-y grob staff)))
               (cons (- (+ origin (* space x)) now-x)
                     (- (* space y) now-y))))
           '(0 . 0)))))
pedalAt =
#(define-music-function (x y on) (number? number? boolean?)
   #{
      <>-\tweak outside-staff-priority ##f
        -\tweak X-offset #0
        -\tweak Y-offset #0
        -\tweak X-extent #'(+inf.0 . -inf.0)
        -\tweak Y-extent #'(+inf.0 . -inf.0)
        -\tweak extra-offset #(op61-pedal-offset x y)
        _\markup \fontsize #-0.5 \musicglyph #(if on "pedal.Ped" "pedal.*")
   #})


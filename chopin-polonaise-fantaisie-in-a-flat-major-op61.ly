% Fixed-edition spacing: note-column targets and physical barline centers.
% Barline internal offsets are removed before placing the containing column.
#(define op61-spaced-systems (make-hash-table))
#(define (op61-interpolate-x x knots)
   (cond ((null? knots) x)
         ((null? (cdr knots)) (+ x (- (cdar knots) (caar knots))))
         ((< x (caar knots)) (+ x (- (cdar knots) (caar knots))))
         (else
          (let loop ((left (car knots)) (right (cdr knots)))
            (if (null? right) (+ x (- (cdr left) (car left)))
                (let ((b (car right)))
                  (if (<= x (car b))
                      (if (< (abs (- (car b) (car left))) 0.000001)
                          (cdr left)
                          (+ (cdr left)
                             (* (/ (- x (car left)) (- (car b) (car left)))
                                (- (cdr b) (cdr left)))))
                      (loop b (cdr right)))))))))
% A bar preceding grace notes may belong to a negative grace-time column.
#(define (op61-paper-column-of grob)
   (let loop ((g grob) (depth 0))
     (cond ((or (not (ly:grob? g)) (> depth 12)) #f)
           ((memq 'paper-column-interface (ly:grob-interfaces g)) g)
           (else (loop (ly:grob-parent g X) (+ depth 1))))))

#(define (op61-place-columns system)
   (if (not (hashq-ref op61-spaced-systems system))
     (begin
       (hashq-set! op61-spaced-systems system #t)
       (let* ((array (ly:grob-object system 'columns))
              (columns (if (ly:grob-array? array) (ly:grob-array->list array) '()))
              (all-array (ly:grob-object system 'all-elements))
              (all (if (ly:grob-array? all-array) (ly:grob-array->list all-array) '()))
              (bar-columns (filter-map
                (lambda (g)
                  (and (eq? (assoc-get 'name (ly:grob-property g 'meta)) 'BarLine)
                       (op61-paper-column-of g))) all))
              (first (and (pair? columns) (car columns)))
              (last-column (and (pair? columns) (car (reverse columns))))
              (moment (and first (ly:grob-property first 'when)))
              (start (and (ly:moment? moment) (ly:moment-main moment)))
              (profile (and start (assoc start op61-spacing-profiles))))
         (if profile
           (let* ((music (cadr profile)) (bars (caddr profile))
                  (origin (ly:grob-relative-coordinate first system X))
                  (space (ly:staff-symbol-staff-space first))
                  (items
                   (map
                    (lambda (c)
                      (let* ((m (ly:grob-property c 'when))
                             (x (ly:grob-relative-coordinate c system X))
                             (time (and (ly:moment? m) (- (ly:moment-main m) start)))
                             (plain (and (ly:moment? m) (= (ly:moment-grace m) 0)))
                             (nonmusic (memq 'non-musical-paper-column-interface (ly:grob-interfaces c)))
                             (bar (and nonmusic
                               (find (lambda (g)
                                 (and (eq? (assoc-get 'name (ly:grob-property g 'meta)) 'BarLine)
                                      (eq? c (op61-paper-column-of g)))) all)))
                             (target (and time (or plain bar)
                                          (assoc time (if nonmusic bars music))))
                             (bar-offset (if (ly:grob? bar)
                               (let ((ex (ly:grob-extent bar c X)))
                                 (* 0.5 (+ (car ex) (cdr ex)))) 0)))
                        (list c x
                          (cond ((eq? c first) origin)
                                ((eq? c last-column) (+ origin (* space (cadddr profile))))
                                (target (- (+ origin (* space (cdr target))) bar-offset))
                                (else #f)) )))
                    columns))
                  (knots (filter-map (lambda (i) (and (caddr i) (cons (cadr i) (caddr i)))) items)))
             (if (pair? knots)
               (for-each
                (lambda (i)
                  (let* ((x (cadr i)) (new (or (caddr i) (op61-interpolate-x x knots))))
                    (ly:grob-translate-axis! (car i) (- new x) X)))
                items))))))))



#(define (op61-trim-empty-continuation grob)
   (let* ((orig (ly:grob-original grob))
          (pieces (if (ly:grob? orig) (ly:spanner-broken-into orig) '()))
          (system (ly:grob-system grob))
          (cols (and (ly:grob? system) (ly:grob-object system 'columns)))
          (left (and (ly:grob-array? cols) (> (ly:grob-array-length cols) 0)
                     (ly:grob-array-ref cols 0)))
          (right (op61-paper-column-of (ly:spanner-bound grob RIGHT)))
          (a (and (ly:grob? left) (ly:grob-property left 'when)))
          (b (and (ly:grob? right) (ly:grob-property right 'when))))
     (if (and (> (length pieces) 1) (eq? grob (car (reverse pieces)))
              (ly:moment? a) (ly:moment? b)
              (<= (ly:moment-main b) (ly:moment-main a)))
         (ly:grob-suicide! grob))))

% Fixed reference-page frames; y is measured downwards from the top margin.
% The music remains editable. Revisit these frames after changing line breaks.
refSystem =
#(define-music-function (y distance) (number? number?)
   #{
      \once \override Score.NonMusicalPaperColumn.line-break-system-details =
        #`((Y-offset . ,y) (alignment-distances . (,distance)))
   #})

% Per-system engraving profiles. Vertical units are staff spaces.
#(define (op61-staff-of object)
   (and (ly:grob? object)
        (let ((staff (ly:grob-object object 'staff-symbol)))
          (if (ly:grob? staff) staff
              (and (memq 'staff-symbol-interface (ly:grob-interfaces object))
                   object)))))

#(define (op61-head-of object)
   (and (ly:grob? object)
        (if (memq 'note-head-interface (ly:grob-interfaces object)) object
            (let ((heads (ly:grob-object object 'note-heads)))
              (and (ly:grob-array? heads)
                   (> (ly:grob-array-length heads) 0)
                   (ly:grob-array-ref heads 0))))))

#(define (op61-slur-staff slur side)
   (let* ((head (op61-head-of (ly:spanner-bound slur side)))
          (direct (op61-staff-of head))
          (columns (ly:grob-object slur 'note-columns)))
     (or direct
         (and (ly:grob-array? columns)
              (let loop ((items (if (= side LEFT)
                                   (ly:grob-array->list columns)
                                   (reverse (ly:grob-array->list columns)))))
                (and (pair? items)
                     (or (op61-staff-of (op61-head-of (car items)))
                         (loop (cdr items))))))
         (op61-staff-of slur))))

#(define (op61-relative-y object reference)
   (let ((common (ly:grob-common-refpoint object reference Y)))
     (- (ly:grob-relative-coordinate object common Y)
        (ly:grob-relative-coordinate reference common Y))))

#(define (op61-piece-index grob pieces)
   (let loop ((items pieces) (index 0))
     (cond ((null? items) #f)
           ((eq? (car items) grob) index)
           (else (loop (cdr items) (+ index 1))))))

#(define (op61-reference-slur label profiles)
   (lambda (slur)
     (let* ((automatic (ly:slur::calc-control-points slur))
            (original (ly:grob-original slur))
            (pieces (ly:spanner-broken-into
                     (if (ly:grob? original) original slur)))
            (index (if (null? pieces)
                       (and (= (length profiles) 1) 0)
                       (op61-piece-index slur pieces))))
       (cond
        ((not index) automatic)
        ((and (pair? pieces) (not (= (length pieces) (length profiles))))
         (ly:warning "Op.61 slur ~a: system count changed; using automatic shape." label)
         automatic)
        (else
         (let* ((profile (list-ref profiles index))
                (left-staff (op61-slur-staff slur LEFT))
                (right-staff (op61-slur-staff slur RIGHT)))
           (if (and (ly:grob? left-staff) (ly:grob? right-staff)
                    (list? automatic) (= (length automatic) 4)
                    (= (length profile) 6))
               (let* ((space (ly:staff-symbol-staff-space slur))
                      (x0 (car (list-ref automatic 0)))
                      (x3 (car (list-ref automatic 3)))
                      (width (- x3 x0))
                      (y0 (+ (op61-relative-y left-staff slur)
                             (* space (list-ref profile 0))))
                      (y3 (+ (op61-relative-y right-staff slur)
                             (* space (list-ref profile 1))))
                      (u1 (list-ref profile 2))
                      (u2 (list-ref profile 4)))
                 (list (cons x0 y0)
                       (cons (+ x0 (* width u1))
                             (+ y0 (* u1 (- y3 y0))
                                (* space (list-ref profile 3))))
                       (cons (+ x0 (* width u2))
                             (+ y0 (* u2 (- y3 y0))
                                (* space (list-ref profile 5))))
                       (cons x3 y3)))
               (begin
                 (ly:warning "Op.61 slur ~a: staff anchor unavailable; using automatic shape." label)
                 automatic))))))))

refSlur =
#(define-music-function (label profiles) (integer? list?)
   #{ \once \override Slur.control-points = #(op61-reference-slur label profiles) #})

#(define (op61-staff-height height)
   (lambda (grob)
     (let ((staff (op61-staff-of grob))
           (parent (ly:grob-parent grob Y)))
       (if (and (ly:grob? staff) (ly:grob? parent))
           (+ (op61-relative-y staff parent)
              (* (ly:staff-symbol-staff-space grob) height))
           (ly:side-position-interface::y-aligned-side grob)))))

% Local reference engraving; coordinates use the current fixed staff frame.
#(define (op61-reference-hairpin lines)
   (lambda (grob)
     (let* ((space (ly:staff-symbol-staff-space grob))
            (x0 (caar lines)) (y0 (cadar lines)))
       (apply ly:stencil-add
         (map (lambda (line)
           (make-line-stencil (* space 0.12)
             (* space (- (list-ref line 0) x0))
             (* space (- (list-ref line 1) y0))
             (* space (- (list-ref line 2) x0))
             (* space (- (list-ref line 3) y0)))) lines)))))
refHairpin =
#(define-music-function (lines) (list?)
   #{ \once \override Hairpin.outside-staff-priority = ##f
      \once \override Hairpin.X-offset = #0
      \once \override Hairpin.Y-offset = #0
      \once \override Hairpin.X-extent = #'(+inf.0 . -inf.0)
      \once \override Hairpin.Y-extent = #'(+inf.0 . -inf.0)
      \once \override Hairpin.stencil = #(op61-reference-hairpin lines)
      \once \override Hairpin.extra-offset =
        #(op61-pedal-offset (caar lines) (cadar lines)) #})
% Broken hairpins keep one musical start/stop and separate reference print profiles.
#(define (op61-hairpin-piece grob profiles)
   (let* ((original (ly:grob-original grob))
          (parts (ly:spanner-broken-into (if (ly:grob? original) original grob)))
          (index (if (null? parts) 0 (op61-piece-index grob parts))))
     (list-ref profiles (min (or index 0) (- (length profiles) 1)))))
refHairpinParts =
#(define-music-function (profiles) (list?)
   #{ \once \override Hairpin.outside-staff-priority = ##f
      \once \override Hairpin.X-offset = #0
      \once \override Hairpin.Y-offset = #0
      \once \override Hairpin.X-extent = #'(+inf.0 . -inf.0)
      \once \override Hairpin.Y-extent = #'(+inf.0 . -inf.0)
      \once \override Hairpin.stencil =
        #(lambda (grob)
           ((op61-reference-hairpin (op61-hairpin-piece grob profiles)) grob))
      \once \override Hairpin.extra-offset =
        #(lambda (grob)
           (let ((lines (op61-hairpin-piece grob profiles)))
             ((op61-pedal-offset (caar lines) (cadar lines)) grob))) #})

beamAt =
#(define-music-function (left right) (number? number?)
   #{ \once \override Beam.positions = #`(,left . ,right) #})

% Local two-note tie profile, used only by the sustained bass chord in m198.
#(define (op61-bass-tie-198 grob)
   (let* ((auto (ly:tie::calc-control-points grob))
          (staff (op61-staff-of grob))
          (space (ly:staff-symbol-staff-space grob))
          (up (> (ly:grob-property grob 'direction 1) 0))
          (profile (if up '(-0.11017 1.18985) '(-2.89000 -4.19002))))
     (if (and (ly:grob? staff) (list? auto) (= (length auto) 4))
         (let* ((x0 (caar auto)) (x3 (car (list-ref auto 3)))
                (w (- x3 x0)) (origin (op61-relative-y staff grob))
                (ye (+ origin (* space (car profile))))
                (yc (+ origin (* space (cadr profile)))))
           (list (cons x0 ye) (cons (+ x0 (* 0.2 w)) yc)
                 (cons (+ x0 (* 0.8 w)) yc) (cons x3 ye)))
         auto)))


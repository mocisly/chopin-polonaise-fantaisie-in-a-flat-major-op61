#(define-music-function (height length) (number? number?)
   #{
      \once \override TrillSpanner.outside-staff-priority = ##f
      \once \override TrillSpanner.Y-offset = #(op61-staff-height height)
      \once \override TrillSpanner.minimum-length = #length
      \once \override TrillSpanner.springs-and-rods = #ly:spanner::set-spacing-rods
   #})

